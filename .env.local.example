# Granio Tribunal — local environment variables
# Copy this file to .env.local and fill in values.
# .env.local is gitignored — never commit your actual keys.

# ─── OpenAI (Prompt Forge only) ───────────────────────────────────────────────
# DEV-ONLY: This key is loaded client-side and visible in browser devtools.
# Safe for local development. Never deploy to a public host with this set.
# For production, proxy OpenAI calls through a backend instead.
VITE_OPENAI_API_KEY=sk-...

# ─── Future: backend API (if added) ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...   # backend-only, never exposed to browser
